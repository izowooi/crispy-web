# =============================================================================
# snapmany — Environment variable template
# 실제 값은 .env.local에 채우세요 (.gitignore로 보호됨).
# =============================================================================

# ---- Replicate (server-only) ----
# 발급: https://replicate.com/account/api-tokens
# 주의: NEXT_PUBLIC_ 접두어 절대 금지(서버 전용 토큰).
REPLICATE_API_TOKEN=

# ---- Firebase Web SDK (client-exposed) ----
# Firebase Console: https://console.firebase.google.com/u/1/project/<projectId>/settings/general
# crispy-web 모노레포 프로젝트의 snapmany web app 설정에서 추출합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- App env (optional) ----
NEXT_PUBLIC_APP_ENV=development

# ---- Access Gate (server-only) ----
# 첫 화면 PasswordGate가 입력값을 /api/auth로 보내 이 값과 비교합니다.
# 값이 비어 있으면 /api/auth가 500을 반환하여 사실상 입장 불가가 됩니다.
# 가벼운 게이트 — 강한 인증(SSO 등)이 필요하면 v1.1에서 도입.
ACCESS_PASSWORD=

# ---- Cloudflare Pages (Optional) ----
# MVP는 Cloudflare 대시보드 수동 업로드 방식이므로 아래 키는 사용하지 않습니다.
# (Phase 1 D3 결정: automated deploy 미사용. 자동 배포로 전환할 때만 채우세요.)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
