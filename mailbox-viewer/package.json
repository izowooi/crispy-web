{
  "name": "mailbox-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages:build": "npx @cloudflare/next-on-pages@1",
    "preview": "npm run pages:build && npx wrangler pages dev .vercel/output/static",
    "deploy": "npm run pages:build && npx wrangler pages deploy .vercel/output/static --project-name mailbox-viewer"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "lucide-react": "^0.511.0",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5",
    "vitest": "^2.1.5",
    "wrangler": "^4"
  }
}
