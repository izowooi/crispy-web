{
  "name": "curry-shot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cloudflare:build": "node scripts/prepare-cloudflare-build.mjs && opennextjs-cloudflare build && node scripts/scrub-build-secrets.mjs && node scripts/verify-build-secrets.mjs",
    "pages:build": "npm run cloudflare:build",
    "preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@cloudflare/workers-types": "5.20260711.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
