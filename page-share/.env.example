# Supabase (fresh-mint project)
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Base URL of this web app (used to generate share URLs)
# Local dev: http://localhost:52741  |  Cloudflare Pages: https://pagekeep.pages.dev
NEXT_PUBLIC_BASE_URL=http://localhost:52741

# Admin password gate (server-side only — never NEXT_PUBLIC_)
# If not set, admin mode is disabled and no one can log in.
ADMIN_PASSWORD=<your-admin-password>

# API key for upload endpoint (POST /api/archives)
# If not set: uploads allowed without auth (local dev mode)
# If set: extension must send X-Api-Key: <value> header to upload
# Server-side only — never NEXT_PUBLIC_
API_KEY=<your-api-key>
