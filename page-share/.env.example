# Supabase (fresh-mint project)
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Local HTML storage directory (absolute or relative to project root)
# Defaults to ./ps_archives when not set
PS_ARCHIVES_DIR=./ps_archives

# Base URL of this web app (used to generate share URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
