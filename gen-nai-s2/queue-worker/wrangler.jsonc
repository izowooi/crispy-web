{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gen-nai-s2-queue",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "MIN_INTERVAL_MS": "15000" },
  "durable_objects": {
    "bindings": [{ "name": "GENERATION_QUEUE", "class_name": "GenerationQueueDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GenerationQueueDO"] }],
  "d1_databases": [{
    "binding": "DB", "database_name": "gen-nai-s2-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "gen-nai-s2-images" }],
  "observability": { "enabled": true }
}
