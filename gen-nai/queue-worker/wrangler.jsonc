{
  "name": "gennai-queue",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MIN_INTERVAL_MS": "2000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOVELAI_QUEUE",
        "class_name": "NovelAiQueueDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NovelAiQueueDO"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "gennai-images"
    }
  ]
}
