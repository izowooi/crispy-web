{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poll",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Only reachable through the Access-protected custom domain. workers.dev and preview URLs would skip Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "poll.zowoo.uk", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poll-db",
      "database_id": "a8b81fbb-a5ba-4b9c-ac78-b01872c11fb0",
      "migrations_dir": "migrations"
    }
  ],
  // Keyed by an HMAC of the user, never the email.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "izowooi.cloudflareaccess.com",
    // Audience tag of the Access application "poll.zowoo.uk".
    "ACCESS_AUD": "9126657547c12a8dfc1f75ba83053fbff3698aa3a21f58af3d452d9e2fe2a222",
    "ALLOWED_HOST": "poll.zowoo.uk",
    "ALLOWED_DOMAIN": "*",
    "ADMIN_EMAILS": "jongwoo.park@wemadeplay.com,izowooi85@gmail.com",
    // Access service-token client ids allowed to call the API (temporary smoke tests only). Keep empty.
    "ALLOWED_SERVICE_TOKENS": ""
  },
  // VOTER_SECRET is a secret (`wrangler secret put VOTER_SECRET`). DEV_EMAIL lives only in .dev.vars.
  // Invocation logs would record request headers, which carry the user's email (Access adds it), so they stay off.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
