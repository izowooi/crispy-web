{
  "name": "chess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --port ${API_PORT:-8787} --env-file .env.local",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "types": "wrangler types",
    "test": "tsx --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply chess --local",
    "db:migrate": "wrangler d1 migrations apply chess --remote",
    "deploy": "npm run build && wrangler deploy",
    "probe": "tsx --use-system-ca --env-file-if-exists=.env.local scripts/probe-engines.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "chess.js": "1.4.0",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "wrangler": "4.151.0"
  }
}
