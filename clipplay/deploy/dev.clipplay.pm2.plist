<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: sed "s#__APP_DIR__#$PWD#g; s#__HOME__#$HOME#g" deploy/dev.clipplay.pm2.plist > ~/Library/LaunchAgents/dev.clipplay.pm2.plist -->
<plist version="1.0"><dict>
<key>Label</key><string>dev.clipplay.pm2</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>__APP_DIR__/deploy/ensure-running.sh</string></array>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>300</integer>
<key>StandardOutPath</key><string>__HOME__/Library/Logs/clipplay-launchd.log</string>
<key>StandardErrorPath</key><string>__HOME__/Library/Logs/clipplay-launchd.log</string>
</dict></plist>
