# Infinite Merge — no API key or client secret is needed.
# Sign in with ChatGPT (open-source/local flow) registers the client dynamically.

# "mock" = offline fake alchemy engine for UI testing (no sign-in). Default: chatgpt
# INFINITE_MERGE_AI=mock

# Force a model slug for every user (otherwise: user's pick, else a small listed model)
# INFINITE_MERGE_MODEL=

# Where the SQLite DB, host id and credential files live (default: ./.data)
# INFINITE_MERGE_DATA_DIR=

# ── Guest mode (no sign-in, Claude Haiku 5.5 on the operator's Anthropic credits) ──
# Put the real key in .env.local (gitignored). Without it the guest button is disabled.
# ANTHROPIC_API_KEY=
# Kill switch: "off" disables guest mode immediately
# INFINITE_MERGE_GUEST=off
# Model calls per guest per day (KST) / for all guests combined per day. Cached recipes are free.
# INFINITE_MERGE_GUEST_DAILY=60
# INFINITE_MERGE_GUEST_GLOBAL_DAILY=1500
