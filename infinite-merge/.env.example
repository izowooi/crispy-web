# Infinite Merge — local settings for `next dev` (copy to .env.local; never commit real values).
# Sign in with ChatGPT (open-source/local flow) needs no key: the client registers dynamically.
# Hosted settings live in wrangler.jsonc (vars) and Worker secrets (`npx wrangler secret put NAME`).

# "mock" = offline fake alchemy engine for UI testing (no sign-in). Default: chatgpt
# INFINITE_MERGE_AI=mock

# Force a model slug for every user (otherwise: user's pick, else a small listed model)
# INFINITE_MERGE_MODEL=

# Where SIWC credential files and the install host id live (default: ./.data). Game data is in D1.
# INFINITE_MERGE_DATA_DIR=

# Turn Sign in with ChatGPT off even on 127.0.0.1 (it is always off on non-loopback hosts)
# INFINITE_MERGE_SIWC=off

# ── Guest mode (no sign-in, Claude Haiku 5.5 on the operator's Anthropic credits) ──
# Put the real key in .env.local (gitignored). Without it the guest button is disabled.
# ANTHROPIC_API_KEY=
# Kill switch: "off" disables guest mode immediately
# INFINITE_MERGE_GUEST=off
# Model calls per guest per day (KST) / for all guests combined per day. Cached recipes are free.
# INFINITE_MERGE_GUEST_DAILY=60
# INFINITE_MERGE_GUEST_GLOBAL_DAILY=1500
# Per hashed client IP per day: model calls / new guest sessions
# INFINITE_MERGE_GUEST_IP_DAILY=150
# INFINITE_MERGE_GUEST_JOIN_IP_DAILY=20

# ── Hosted only (Worker secrets, not .env.local) ──
# IM_IP_SALT            random salt for hashing client IPs
# TURNSTILE_SECRET_KEY  Turnstile widget secret (site key is a var in wrangler.jsonc)
